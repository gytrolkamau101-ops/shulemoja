VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# IntaSend — PUBLISHABLE key only in the browser
VITE_INTASEND_PUBLIC_KEY=ISPubKey_test_...
# false = sandbox keys, true = live keys (must match secret on Netlify)
VITE_INTASEND_LIVE=false

# Optional: when testing STK from localhost, point at your deployed Netlify site
# VITE_FUNCTIONS_BASE=https://YOUR-SITE.netlify.app

# --- Netlify only (Site settings → Environment, NOT in Vite client) ---
# INTASEND_SECRET_KEY=ISSecretKey_test_...
# INTASEND_LIVE=false
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# INTASEND_WEBHOOK_CHALLENGE=your-random-string
